# Copy to `.env.test`: the database and settings used by Vitest (tests/helpers/setup.ts), Playwright (e2e/global-setup.ts, playwright.config.ts) and `npm run db:migrate:test`.
# The database name MUST end in _test: scripts/reset-test-db.ts truncates every table in it and refuses anything else.
#   createdb jr_logistics_test && npm run db:migrate:test
DATABASE_URL=postgres://localhost:5432/jr_logistics_test
DEMO_MODE=true
APP_URL=http://localhost:3000
CRON_SECRET=test-cron-secret
SUPER_ADMIN_EMAIL=admin@jrlogistics.test
SUPER_ADMIN_PASSWORD=E2e!Password2026
