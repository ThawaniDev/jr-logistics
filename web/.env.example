# JR Logistics web — environment variables. Copy to `.env.local` (dev) and fill in; production reads the real environment.
# Every variable the code reads is listed here (grep `process.env` in src/ and scripts/ to re-check). `memory/RUNBOOK.md` has the same table with defaults.
#
# A PRODUCTION build (NODE_ENV=production) checks its configuration when it starts and REFUSES TO START (exit 1, JSON log lines on stderr) when it is
# missing DATABASE_URL or AUTH_SECRET, has a placeholder/short (<16) AUTH_SECRET or CRON_SECRET, or an unsupported / incomplete STORAGE_DRIVER. See src/lib/env-check.ts.

# ───────── Database ─────────
DATABASE_URL=postgres://localhost:5432/jr_logistics
# Max connections in the pool (default 10). A request waits at most 20 s for a free one.
# DB_POOL_MAX=10
# A second small pool used only by the analytics reports (a heavy report load must not slow the API down): default 4. An instance opens at most DB_POOL_MAX + REPORT_POOL_MAX connections.
# REPORT_POOL_MAX=4

# ───────── Secrets (REQUIRED in production, 32+ random characters each: `openssl rand -hex 32`) ─────────
# Signs delivery codes and two-step sign-in tokens. Changing it retires every delivery code and pending two-step token.
AUTH_SECRET=
# Authorises POST /api/v1/cron/tick and the operator view of GET /api/v1/health. Not a placeholder, not "change-me".
CRON_SECRET=
# Encrypts warehouse-system credentials (LogesTech API keys …) at rest. Any long random string. Changing it makes stored keys unreadable.
# INTEGRATIONS_SECRET=

# ───────── Super admin (first start only: scripts/seed.ts creates it; an existing admin's password is never overwritten) ─────────
# The admin signs in with the part of the e-mail before the @ (or the e-mail itself). The password is temporary (it must be changed at the first sign-in), but on a
# non-demo deployment a guessable one is refused when the admin is created: 12+ characters, letters and digits, none of "password", "admin", "changeme", "123456".
SUPER_ADMIN_EMAIL=admin@jrlogistics.local
SUPER_ADMIN_PASSWORD=

# ───────── Public address ─────────
# Used in tracking links sent by SMS / notifications. Set it to the public https:// address in production.
APP_URL=http://localhost:3000
# How many reverse proxies sit in front of the app. The client IP (rate limits, audit) is read from the RIGHT of X-Forwarded-For.
# 1 (default) | 2 … | cloudflare (uses CF-Connecting-IP) | none (directly exposed: trust no header)
# TRUSTED_PROXY=1

# ───────── Demo mode (OTP-free demo accounts on the sign-in page, simulated top-ups) ─────────
# Never enable it on a site with real customers: the demo card publishes the super-admin credentials by design.
# In NODE_ENV=production it additionally requires ALLOW_DEMO_IN_PRODUCTION=yes-this-is-a-demo-deployment (otherwise it stays OFF and a warning is logged).
DEMO_MODE=true
# ALLOW_DEMO_IN_PRODUCTION=yes-this-is-a-demo-deployment
# Tests only: lets outbound calls (partner APIs, webhooks) reach http:// and private addresses in a production build. Never set it on a real deployment.
# ALLOW_PRIVATE_OUTBOUND=yes-this-is-a-test-deployment

# ───────── Document storage ─────────
# In production there is NO implicit local fallback: configure a durable adapter or opt in to local disk (single node, persistent volume).
STORAGE_DRIVER=
# STORAGE_DRIVER=local → folder for uploads (default ./uploads inside the app folder: lost when a container is rebuilt)
UPLOAD_DIR=
# STORAGE_DRIVER=s3 works with AWS S3, Cloudflare R2, MinIO … (objects stay private; the app streams them to authorised users)
# S3_BUCKET=
# S3_REGION=            # e.g. me-south-1 (AWS) or "auto" (R2, the default)
# S3_ENDPOINT=          # leave empty for AWS; e.g. https://<account>.r2.cloudflarestorage.com for R2, http://minio:9000 for MinIO
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SSE=AES256         # optional server-side encryption header (AWS)

# ───────── Housekeeping (webhook retries, offer/request/document expiry, settlements) ─────────
# Either run it in-process on every instance (safe with replicas: one at a time through a Postgres advisory lock)…
# INTERNAL_SCHEDULER=true
# SCHEDULER_INTERVAL_SEC=60   # minimum 10
# …or call POST /api/v1/cron/tick every minute from an external scheduler with "Authorization: Bearer $CRON_SECRET" (required on serverless hosts).

# ───────── Maps and routing ─────────
# Best route for drivers (server-side key — never ship it to a client). Enable BOTH "Routes API" and "Geocoding API" on it.
# Without it the app still works: stops are ordered with a clearly-labelled local estimate (straight-line distances, not traffic-aware).
GOOGLE_MAPS_API_KEY=
# Stops sent to Google per route call (destination + optimised intermediates). Google allows 25 intermediates = 26 stops; default 25 leaves one spare. Range 3–26.
# ROUTE_STOPS_PER_CALL=25
# Endpoint overrides for tests and staging stubs (production leaves them unset).
# GOOGLE_ROUTES_URL=
# GOOGLE_GEOCODE_URL=
# Map tiles in the web UI (build-time, public). OpenStreetMap's public servers are for light use only: point this at a commercial / self-hosted tile service before launch.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ───────── Tuning and tooling (all optional) ─────────
# How long report results are cached in memory, in ms (default 30000).
# ANALYTICS_CACHE_TTL_MS=30000
# Port `next start` / `next dev` listens on in the Docker image (default 3000).
# PORT=3000
# Alternative .env file read by `db:*` scripts and drizzle-kit (default .env.local; `db:migrate:test` uses .env.test).
# ENV_FILE=.env.local
# A second Next.js build folder, so a test server never overwrites the dev server's `.next` (Playwright uses .next-e2e).
# NEXT_DIST_DIR=.next
# Port of the Playwright production server (default 3101; 3100 belongs to another project on the development Mac).
# E2E_PORT=3101
# Prints the internal counters of the demo-history simulator (npm run db:seed:history).
# HISTORY_DEBUG=1
